# PlanPass environment template (copy to .env.local — never commit secrets)
# Neon — pulled by `neon deploy` / `neon env pull`
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_BRANCH=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# Meta Model API (used directly — set MODEL_API_KEY from your Meta AI API key)
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Optional: app-set only (NOT injected by Neon) — needed by DB driver upgrade
RESEND_API_KEY=
PORT=3000
