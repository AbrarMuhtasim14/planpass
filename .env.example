# PlanPass Environment Variables (Example Template)
# Copy to .env and populate with your own credentials

# Neon Serverless Postgres
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/planpass?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/planpass?sslmode=require
NEON_BRANCH=production

# Neon Managed Auth (Better Auth)
NEON_AUTH_BASE_URL=https://sample-auth.neon.tech/api/auth
NEON_AUTH_JWKS_URL=https://sample-auth.neon.tech/.well-known/jwks.json
NEON_REALTIME_URL=wss://sample.neon.tech/realtime
NEON_REALTIME_SECRET=sample_realtime_secret

# Neon Functions
NEON_FUNCTION_HELLO_BASE_URL=https://sample-func.neon.tech

# Meta Model API (https://api.meta.ai/v1)
MODEL_API_KEY=meta_api_key_here
META_API_BASE_URL=https://api.meta.ai/v1

# AWS S3 Storage
AWS_ACCESS_KEY_ID=sample_access_key
AWS_SECRET_ACCESS_KEY=sample_secret_key
AWS_ENDPOINT_URL_S3=https://sample.r2.cloudflarestorage.com
AWS_REGION=auto

# Optional Notifications
RESEND_API_KEY=re_sample_resend_key
