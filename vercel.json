{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/benchmarks/(.*)", "destination": "/benchmarks/$1" },
    { "source": "/auth", "destination": "/auth.html" }
  ]
}
